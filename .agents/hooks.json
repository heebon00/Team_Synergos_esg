{
  "token-compliance": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/check_token_compliance.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
